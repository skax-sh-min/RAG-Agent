# ============================================================
# Caddy 리버스 프록시 도메인
# ============================================================
# 로컬 테스트: DOMAIN=localhost (Caddy 로컬 CA 인증서 자동 생성)
# 운영:        DOMAIN=example.com (Let's Encrypt 자동 발급)
DOMAIN=localhost
USE_CADDY_REVERSE_PROXY_HTTPS=false

# ============================================================
# Auth
# ============================================================
# Set to false to disable login — guest/admin auto-login. First access creates admin via /setup.
AUTH_ENABLED=true

# ============================================================
# API Keys
# ============================================================
# Required for OpenAI providers in app.llm.providers[].
# Not needed if all providers use Gemini or local endpoints.

# OpenAI(ChatGPT) - required for gpt-4o / gpt-4o-mini providers
OPENAI_API_KEY=your-openai-api-key-here

# Gemini — required for gemini-flash / gemini-pro providers
GEMINI_API_KEY1=your-gemini-api-key-here
GEMINI_API_KEY2=your-gemini-api-key-here

# ============================================================
# Spring AI global endpoint  (spring.ai.openai.* fallback beans)
# Not used for LLM inference when multi-provider routing is active.
# ============================================================
# Azure OpenAI 엔드포인트로 교체 가능
OPENAI_BASE_URL=https://api.openai.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ============================================================
# Local LLM provider  (app.llm.providers[0] — role: LOCAL)
# Spring AI global endpoint  (spring.ai.openai.* fallback beans)
# Separated from OPENAI_* so embedding and local LLM can be configured
# independently.  Defaults point to LM Studio on localhost.
# ============================================================
LOCAL_LLM_URL=http://localhost:1234/v1
# LOCAL_LLM_KEY is optional for local endpoints (llama-server / LM Studio ignore it).
# Leave it blank — the LOCAL provider is still registered (a "no-key" placeholder is substituted).
LOCAL_LLM_KEY=
LOCAL_LLM_MODEL=google/gemma-4-e4b
# Routing mode (default COST_FIRST). For air-gapped / local-only operation set LOCAL_ONLY
# to block every external provider call regardless of any configured cloud keys.
#LLM_ROUTING_MODE=LOCAL_ONLY

# ============================================================
# Embedding model  (app.embedding.*)
# Dedicated endpoint for document indexing and vector search.
# Fully decoupled from the LLM inference providers.
#
# If the EMBED_LLM environment variable has no value, 
# the value of LOCAL_LLM is applied.
#
# Examples:
#   LMStudio EMBED_BASE_URL=http://localhost:1234/v1
#   OpenAI:  EMBED_BASE_URL=https://api.openai.com
#
# WARNING: changing EMBED_MODEL after indexing requires full re-indexing
#          (vector dimensions must stay consistent within a collection).
# ============================================================
#EMBED_BASE_URL=http://localhost:1234/v1
#EMBED_API_KEY=your-embeding-llm-api-key-here
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBED_DIMENSIONS — REQUIRED only for VECTORSTORE_TYPE=sqlite-vec. Must equal the embedding
# model's real output dimension (nomic-embed-text=768, bge-m3=1024, text-embedding-3-small=1536).
# Leave unset for chroma (dimension is auto-detected there). A wrong value breaks sqlite-vec insert/search.
#EMBED_DIMENSIONS=768

# Embedding을 OpenAI로 교체 (고비용, 고성능)
# EMBED_BASE_URL=${OPENAI_BASE_URL}         # OPENAI 엔드포인트로 교체
# EMBED_API_KEY=${OPENAI_API_KEY}           # OPENAI 키를 재사용
# EMBED_MODEL=text-embedding-3-large        # OPENAI 임베딩 모델

# Embedding을 Gemini로 교체 (고비용, 고성능)
# EMBED_BASE_URL=${GEMINI_BASE_URL}         # Gemini 엔드포인트로 교체
# EMBED_API_KEY=${GEMINI_API_KEY1}          # Gemini 키를 재사용
# EMBED_MODEL=text-embedding-004            # Gemini 임베딩 모델

# ============================================================
# Vector store backend
# ============================================================
# chroma (default, Docker 필요) | sqlite-vec (외부 의존 없음)
#VECTORSTORE_TYPE=chroma
# sqlite-vec 사용 시에만 필요 — vec0 로더블 확장 바이너리 절대경로.
# 공식 Maven 아티팩트가 없어 운영자가 직접 배치한다 (suffix .so/.dylib/.dll 생략 가능).
# 바이너리: https://github.com/asg017/sqlite-vec/releases (플랫폼별 loadable)
#SQLITE_VEC_EXTENSION_PATH=/opt/sqlite-vec/vec0
# 선택: load_extension 엔트리포인트 강제 (비우면 SQLite가 파일명에서 유추).
# 엔트리포인트 오류로 로드 실패 시에만 sqlite3_vec_init 지정.
#SQLITE_VEC_ENTRYPOINT=
# 선택: 벡터/FTS 테이블을 memory.db 와 분리해 별도 파일에 저장 (인덱싱 I/O 격리).
# 비우면(기본) memory.db 에 함께 저장. 전환 시 재인덱싱 필요(벡터 미이전).
#SQLITE_VEC_DB_PATH=./data/vector.db
#
# Docker Compose: chroma 백엔드는 chroma 프로파일을 켜야 컨테이너가 뜬다.
#   chroma    →  docker compose --profile chroma up   (또는 아래 COMPOSE_PROFILES=chroma)
#   sqlite-vec →  docker compose up                    (chroma 컨테이너 미기동)
#COMPOSE_PROFILES=chroma

# ============================================================
# ChromaDB
# ============================================================
CHROMA_HOST=http://localhost
CHROMA_PORT=8001

# ============================================================
# HTTP timeouts
# Used by application.properties timeout bindings.
# ============================================================
# Browser <-> server SSE timeout (seconds)
#SSE_TIMEOUT_SECONDS=300
#INDEXING_KEYWORD_TIMEOUT_SECONDS=180

# LLM provider HTTP timeout (seconds)
#LLM_CONNECT_TIMEOUT_SECONDS=10
#LLM_READ_TIMEOUT_SECONDS=180

# Embedding HTTP timeout (seconds)
#EMBED_CONNECT_TIMEOUT_SECONDS=10
#EMBED_READ_TIMEOUT_SECONDS=120

# Chroma HTTP timeout (seconds)
#CHROMA_CONNECT_TIMEOUT_SECONDS=5
#CHROMA_READ_TIMEOUT_SECONDS=60

# ============================================================
# Storage
# ============================================================
DATA_DIR=./data

# ============================================================
# RAG tuning
# Range guidance:
#   CHUNK_SIZE                 300  ~ 2000  (chars) — smaller = precise, larger = context-rich
#   CHUNK_OVERLAP              0    ~ 25% of CHUNK_SIZE — cross-boundary context only
#   MIN_CHUNK_SIZE             50   ~ 25% of CHUNK_SIZE — tiny-chunk merge threshold
#   SEARCH_TOP_K               2    ~ 15    — more docs = higher recall, more tokens
#   SEARCH_SIMILARITY_THRESHOLD 0.0 ~ 0.75  — min cosine similarity; 0.0 = accept all
#   SEARCH_MULTIQUERY_ENABLED  true/false   — expand query via LLM before search
#   SEARCH_MULTIQUERY_MIN_LENGTH 0  ~ 20    — skip expansion for short queries (0 = always expand)
#   SEARCH_HYBRID_ENABLED      true/false   — add BM25 (FTS5) keyword axis to RRF (re-index required)
#   SEARCH_RETRY_ESCALATE      true/false   — grow candidate pool on retry ×(retryCount+1), capped ×3
#   SEARCH_RERANK_ENABLED      true/false   — LLM reranking after RRF (adds 1 LLM call/turn)
#   SEARCH_CANDIDATE_MULTIPLIER 2   ~ 5     — pool size for reranking: topK × N
#   MAX_RETRY_COUNT            0    ~ 4     — retrieval re-attempt limit
# ============================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=200
SEARCH_TOP_K=7
#SEARCH_SIMILARITY_THRESHOLD=0.0
#SEARCH_MULTIQUERY_ENABLED=true
#SEARCH_MULTIQUERY_MIN_LENGTH=0
#SEARCH_HYBRID_ENABLED=false
#SEARCH_RETRY_ESCALATE=true
#SEARCH_RERANK_ENABLED=false
#SEARCH_CANDIDATE_MULTIPLIER=3
MAX_RETRY_COUNT=2

# ============================================================
# LLM response parameters
#   LLM_MAX_TOKENS    1000 ~ 32000 — max output tokens per response;
#                                    increase for long summaries / complex answers
#   LLM_TEMPERATURE   0.0  ~ 2.0  — 0.0 = deterministic (recommended for RAG),
#                                    higher = more creative / varied responses
# ============================================================
#LLM_MAX_TOKENS=8000
#LLM_TEMPERATURE=0.0

# ============================================================
# Indexing parallelism
# Range guidance:
#   INDEXING_MAX_FILES     1 ~ 8  — parallel file indexing workers
#   INDEXING_MAX_LLM       1 ~ 16 — parallel LLM calls during indexing
# ============================================================
# INDEXING_MAX_FILES=4
# INDEXING_MAX_LLM=4

# ============================================================
# Log levels
#   INFO  — production default: indexing events, sync results, provider registration
#   DEBUG — agent flow (Classifier→Retrieval→Answer→Critic), routing decisions,
#            LLM curl replay commands. WARNING: includes full prompt content —
#            do NOT use in production.
#   TRACE — full HTTP request/response bytes (very verbose during SSE streaming)
# Logging levels can also be changed at runtime without restart via Actuator:
#   POST /actuator/loggers/com.example.ragagent  {"configuredLevel":"DEBUG"}
# ============================================================
#LOGGING_LEVEL=INFO
#SPRING_SECURITY_LOGGING_LEVEL=WARN

# ============================================================
# Multi-LLM Provider routing  (application.properties snippet)
#
# Copy the block below into src/main/resources/application.properties
# to enable multi-provider routing.  Roles: LOCAL → NORMAL → PREMIUM
# Priority: lower number = higher preference within the same role.
# Routing modes: COST_FIRST | QUALITY_FIRST | PROGRESSIVE | DUAL | LOCAL_ONLY
# See documents/LLM_ROUTING.md for full reference.
# ============================================================
# app.llm.default-routing-mode=COST_FIRST
# app.llm.circuit-breaker-minutes=2
# app.llm.progressive-threshold=0.6

# ── [LOCAL] Generic local LLM — free, handles all task types ───────────
# app.llm.providers[0].name=local
# app.llm.providers[0].base-url=${LOCAL_LLM_URL:http://localhost:1234/v1}
# app.llm.providers[0].api-key=${LOCAL_LLM_KEY:lm-studio}
# app.llm.providers[0].model=${LOCAL_LLM_MODEL:gemma-4-27b-it}
# app.llm.providers[0].type=BOTH
# app.llm.providers[0].role=LOCAL
# app.llm.providers[0].priority=0

# ── [LOCAL] Vision-dedicated local model (optional) ────────────────────
# app.llm.providers[6].name=local-vision
# app.llm.providers[6].base-url=${LOCAL_LLM_URL:http://localhost:1235/v1}
# app.llm.providers[6].api-key=${LOCAL_LLM_KEY:lm-studio}
# app.llm.providers[6].model=llava-1.6-34b
# app.llm.providers[6].type=VISION
# app.llm.providers[6].role=LOCAL
# app.llm.providers[6].priority=0

