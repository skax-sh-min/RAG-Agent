# ============================================================
# API Keys
# ============================================================
# Required for OpenAI providers in app.llm.providers[].
# Not needed if all providers use Gemini or local endpoints.
OPENAI_API_KEY=your-openai-api-key-here

# Gemini — required for gemini-flash / gemini-pro providers
# GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================
# Embedding model  (app.embedding.*)
# Dedicated endpoint for document indexing and vector search.
# Fully decoupled from the LLM inference providers.
#
# EMBED_BASE_URL is REQUIRED — the app will not start without it.
#
# Examples:
#   OpenAI:  EMBED_BASE_URL=https://api.openai.com
#   Ollama:  EMBED_BASE_URL=http://localhost:11434/v1
#   LMStudio EMBED_BASE_URL=http://localhost:1234/v1
#
# WARNING: changing EMBED_MODEL after indexing requires full re-indexing
#          (vector dimensions must stay consistent within a collection).
# ============================================================
EMBED_BASE_URL=https://api.openai.com
EMBED_API_KEY=your-embed-api-key-here   # default: OPENAI_API_KEY
EMBED_MODEL=text-embedding-ada-002

# 글로벌 레이어를 OpenAI에서 Gemini 엔드포인트로 교체
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=${GEMINI_API_KEY}          # Gemini 키를 재사용
# EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  # Gemini 엔드포인트로 교체
# EMBED_API_KEY=${GEMINI_API_KEY}          # Gemini 키를 재사용
# EMBED_MODEL=text-embedding-004            # Gemini 임베딩 모델

# ============================================================
# Spring AI global endpoint  (spring.ai.openai.* fallback beans)
# Not used for LLM inference when multi-provider routing is active.
# ============================================================
OPENAI_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4o

# ============================================================
# Local LLM provider  (app.llm.providers[0] — role: LOCAL)
# Separated from OPENAI_* so embedding and local LLM can be configured
# independently.  Defaults point to LM Studio on localhost.
# ============================================================
# LOCAL_LLM_URL=http://localhost:1234/v1
# LOCAL_LLM_KEY=lm-studio
# LOCAL_LLM_MODEL=gemma-4-27b-it

# ============================================================
# ChromaDB
# ============================================================
CHROMA_HOST=http://localhost
CHROMA_PORT=8001

# ============================================================
# Storage
# ============================================================
DATA_DIR=./data

# ============================================================
# RAG tuning
# Range guidance:
#   CHUNK_SIZE             300  ~ 2000  (chars) — smaller = precise, larger = context-rich
#   CHUNK_OVERLAP          0    ~ 25% of CHUNK_SIZE — cross-boundary context
#   SEARCH_TOP_K           2    ~ 15    — more docs = higher recall, more tokens
#   MAX_RETRY_COUNT        0    ~ 4     — retrieval re-attempt limit
#   MAX_CONVERSATION_CHARS 1000 ~ 20000 — multi-turn history window
# ============================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=100
SEARCH_TOP_K=7
MAX_RETRY_COUNT=2
MAX_CONVERSATION_CHARS=8000

# ============================================================
# Indexing parallelism
# Range guidance:
#   INDEXING_MAX_FILES     1 ~ 8  — parallel file indexing workers
#   INDEXING_MAX_LLM       1 ~ 16 — parallel LLM calls during indexing
# ============================================================
# INDEXING_MAX_FILES=4
# INDEXING_MAX_LLM=8

# ============================================================
# Multi-LLM Provider routing  (application.properties snippet)
#
# Copy the block below into src/main/resources/application.properties
# to enable multi-provider routing.  Roles: LOCAL → NORMAL → PREMIUM
# Priority: lower number = higher preference within the same role.
# Routing modes: COST_FIRST | QUALITY_FIRST | PROGRESSIVE | DUAL | LOCAL_ONLY
# See documents/LLM_ROUTING.md for full reference.
# ============================================================
#
# app.llm.default-routing-mode=COST_FIRST
# app.llm.circuit-breaker-minutes=2
# app.llm.progressive-threshold=0.6
#
# ── [LOCAL] Generic local LLM — free, handles all task types ───────────
# app.llm.providers[0].name=local
# app.llm.providers[0].base-url=${LOCAL_LLM_URL:http://localhost:1234/v1}
# app.llm.providers[0].api-key=${LOCAL_LLM_KEY:lm-studio}
# app.llm.providers[0].model=${LOCAL_LLM_MODEL:gemma-4-27b-it}
# app.llm.providers[0].type=LIGHT_BOTH
# app.llm.providers[0].role=LOCAL
# app.llm.providers[0].priority=0
#
# ── [LOCAL] Vision-dedicated local model (optional) ────────────────────
# app.llm.providers[5].name=local-vision
# app.llm.providers[5].base-url=${LOCAL_LLM_URL:http://localhost:1235/v1}
# app.llm.providers[5].api-key=${LOCAL_LLM_KEY:lm-studio}
# app.llm.providers[5].model=llava-1.6-34b
# app.llm.providers[5].type=VISION
# app.llm.providers[5].role=LOCAL
# app.llm.providers[5].priority=0
#
# ── [NORMAL] Gemini Flash — low-cost, primary ──────────────────────────
# app.llm.providers[1].name=gemini-flash
# app.llm.providers[1].base-url=https://generativelanguage.googleapis.com/v1beta/openai/
# app.llm.providers[1].api-key=${GEMINI_API_KEY}
# app.llm.providers[1].model=gemini-2.5-flash
# app.llm.providers[1].type=BOTH
# app.llm.providers[1].role=NORMAL
# app.llm.providers[1].priority=1
#
# ── [NORMAL] OpenAI Mini — low-cost, fallback ──────────────────────────
# app.llm.providers[2].name=openai-mini
# app.llm.providers[2].base-url=https://api.openai.com
# app.llm.providers[2].api-key=${OPENAI_API_KEY}
# app.llm.providers[2].model=gpt-4o-mini
# app.llm.providers[2].type=BOTH
# app.llm.providers[2].role=NORMAL
# app.llm.providers[2].priority=2
#
# ── [PREMIUM] Gemini Pro — high-reasoning, primary ─────────────────────
# app.llm.providers[3].name=gemini-pro
# app.llm.providers[3].base-url=https://generativelanguage.googleapis.com/v1beta/openai/
# app.llm.providers[3].api-key=${GEMINI_API_KEY}
# app.llm.providers[3].model=gemini-2.5-pro
# app.llm.providers[3].type=BOTH
# app.llm.providers[3].role=PREMIUM
# app.llm.providers[3].priority=3
#
# ── [PREMIUM] OpenAI GPT-4o — high-reasoning, fallback ────────────────
# app.llm.providers[4].name=openai
# app.llm.providers[4].base-url=https://api.openai.com
# app.llm.providers[4].api-key=${OPENAI_API_KEY}
# app.llm.providers[4].model=gpt-5o
# app.llm.providers[4].type=BOTH
# app.llm.providers[4].role=PREMIUM
# app.llm.providers[4].priority=4
