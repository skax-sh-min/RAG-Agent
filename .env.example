# ============================================================
# API Keys
# ============================================================
# Required for OpenAI providers in app.llm.providers[].
# Not needed if all providers use Gemini or local endpoints.

# OpenAI(ChatGPT) - required for gpt-4o / gpt-4o-mini providers
OPENAI_API_KEY=your-openai-api-key-here

# Gemini — required for gemini-flash / gemini-pro providers
GEMINI_API_KEY1=your-gemini-api-key-here
GEMINI_API_KEY2=your-gemini-api-key-here

# ============================================================
# Spring AI global endpoint  (spring.ai.openai.* fallback beans)
# Not used for LLM inference when multi-provider routing is active.
# ============================================================
# Azure OpenAI 엔드포인트로 교체 가능
OPENAI_BASE_URL=https://api.openai.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ============================================================
# Local LLM provider  (app.llm.providers[0] — role: LOCAL)
# Spring AI global endpoint  (spring.ai.openai.* fallback beans)
# Separated from OPENAI_* so embedding and local LLM can be configured
# independently.  Defaults point to LM Studio on localhost.
# ============================================================
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_KEY=your-local-llm-api-key-here
LOCAL_LLM_MODEL=google/gemma-4-e4b

# ============================================================
# Embedding model  (app.embedding.*)
# Dedicated endpoint for document indexing and vector search.
# Fully decoupled from the LLM inference providers.
#
# If the EMBED_LLM environment variable has no value, 
# the value of LOCAL_LLM is applied.
#
# Examples:
#   LMStudio EMBED_BASE_URL=http://localhost:1234/v1
#   OpenAI:  EMBED_BASE_URL=https://api.openai.com
#
# WARNING: changing EMBED_MODEL after indexing requires full re-indexing
#          (vector dimensions must stay consistent within a collection).
# ============================================================
#EMBED_BASE_URL=http://localhost:1234/v1
#EMBED_API_KEY=your-embeding-llm-api-key-here
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# Embedding을 OpenAI로 교체 (고비용, 고성능)
# EMBED_BASE_URL=${OPENAI_BASE_URL}         # OPENAI 엔드포인트로 교체
# EMBED_API_KEY=${OPENAI_API_KEY}           # OPENAI 키를 재사용
# EMBED_MODEL=text-embedding-3-large        # OPENAI 임베딩 모델

# Embedding을 Gemini로 교체 (고비용, 고성능)
# EMBED_BASE_URL=${GEMINI_BASE_URL}         # Gemini 엔드포인트로 교체
# EMBED_API_KEY=${GEMINI_API_KEY1}          # Gemini 키를 재사용
# EMBED_MODEL=text-embedding-004            # Gemini 임베딩 모델

# ============================================================
# ChromaDB
# ============================================================
CHROMA_HOST=http://localhost
CHROMA_PORT=8001

# ============================================================
# HTTP timeouts
# Used by application.properties timeout bindings.
# ============================================================
# Browser <-> server SSE timeout (seconds)
#SSE_TIMEOUT_SECONDS=300
#INDEXING_KEYWORD_TIMEOUT_SECONDS=180

# LLM provider HTTP timeout (seconds)
#LLM_CONNECT_TIMEOUT_SECONDS=10
#LLM_READ_TIMEOUT_SECONDS=180

# Embedding HTTP timeout (seconds)
#EMBED_CONNECT_TIMEOUT_SECONDS=10
#EMBED_READ_TIMEOUT_SECONDS=120

# Chroma HTTP timeout (seconds)
#CHROMA_CONNECT_TIMEOUT_SECONDS=5
#CHROMA_READ_TIMEOUT_SECONDS=60

# ============================================================
# Storage
# ============================================================
DATA_DIR=./data

# ============================================================
# RAG tuning
# Range guidance:
#   CHUNK_SIZE             300  ~ 2000  (chars) — smaller = precise, larger = context-rich
#   CHUNK_OVERLAP          0    ~ 25% of CHUNK_SIZE — cross-boundary context
#   SEARCH_TOP_K           2    ~ 15    — more docs = higher recall, more tokens
#   MAX_RETRY_COUNT        0    ~ 4     — retrieval re-attempt limit
#   MAX_CONVERSATION_CHARS 1000 ~ 20000 — multi-turn history window
# ============================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=100
SEARCH_TOP_K=7
MAX_RETRY_COUNT=2
MAX_CONVERSATION_CHARS=8000

# ============================================================
# Indexing parallelism
# Range guidance:
#   INDEXING_MAX_FILES     1 ~ 8  — parallel file indexing workers
#   INDEXING_MAX_LLM       1 ~ 16 — parallel LLM calls during indexing
# ============================================================
# INDEXING_MAX_FILES=4
# INDEXING_MAX_LLM=6

# ============================================================
# Multi-LLM Provider routing  (application.properties snippet)
#
# Copy the block below into src/main/resources/application.properties
# to enable multi-provider routing.  Roles: LOCAL → NORMAL → PREMIUM
# Priority: lower number = higher preference within the same role.
# Routing modes: COST_FIRST | QUALITY_FIRST | PROGRESSIVE | DUAL | LOCAL_ONLY
# See documents/LLM_ROUTING.md for full reference.
# ============================================================
# app.llm.default-routing-mode=COST_FIRST
# app.llm.circuit-breaker-minutes=2
# app.llm.progressive-threshold=0.6

# ── [LOCAL] Generic local LLM — free, handles all task types ───────────
# app.llm.providers[0].name=local
# app.llm.providers[0].base-url=${LOCAL_LLM_URL:http://localhost:1234/v1}
# app.llm.providers[0].api-key=${LOCAL_LLM_KEY:lm-studio}
# app.llm.providers[0].model=${LOCAL_LLM_MODEL:gemma-4-27b-it}
# app.llm.providers[0].type=BOTH
# app.llm.providers[0].role=LOCAL
# app.llm.providers[0].priority=0

# ── [LOCAL] Vision-dedicated local model (optional) ────────────────────
# app.llm.providers[6].name=local-vision
# app.llm.providers[6].base-url=${LOCAL_LLM_URL:http://localhost:1235/v1}
# app.llm.providers[6].api-key=${LOCAL_LLM_KEY:lm-studio}
# app.llm.providers[6].model=llava-1.6-34b
# app.llm.providers[6].type=VISION
# app.llm.providers[6].role=LOCAL
# app.llm.providers[6].priority=0

