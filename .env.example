# ============================================================
# Required
# ============================================================
OPENAI_API_KEY=your-api-key-here

# ============================================================
# LLM / Embedding endpoint (OpenAI or compatible)
# ============================================================
OPENAI_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4o
EMBED_MODEL=text-embedding-ada-002

# Local LLM example (LM Studio / Ollama):
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=lm-studio
# LLM_MODEL=google/gemma-4-e4b
# EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# ============================================================
# ChromaDB
# ============================================================
CHROMA_HOST=http://localhost
CHROMA_PORT=8001

# ============================================================
# Storage
# ============================================================
DATA_DIR=./data

# ============================================================
# RAG tuning
# Range guidance:
#   CHUNK_SIZE            300  ~ 2000  (chars) — smaller = precise, larger = context-rich
#   CHUNK_OVERLAP         0    ~ 25% of CHUNK_SIZE — cross-boundary context
#   SEARCH_TOP_K          2    ~ 15    — more docs = higher recall, more tokens
#   MAX_RETRY_COUNT       0    ~ 4     — retrieval re-attempt limit
#   MAX_CONVERSATION_CHARS 1000 ~ 20000 — multi-turn history window
# ============================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=100
SEARCH_TOP_K=6
MAX_RETRY_COUNT=2
MAX_CONVERSATION_CHARS=7000
