# ============================================================
# 폐쇄망(air-gapped) / no-docker 구성 예시
# ------------------------------------------------------------
#   - Vector store : sqlite-vec (ChromaDB·Docker 불필요)
#   - LLM          : llama-server 로컬 단일 엔드포인트만 사용 (외부 호출 전면 차단)
#   - Auth         : 비활성 (guest/admin 자동 로그인)
#   - Reverse proxy: 미사용
#
# 사용법:
#   cp .env.example.sqlite .env
#   # SQLITE_VEC_EXTENSION_PATH / EMBED_DIMENSIONS / 모델명을 환경에 맞게 수정
#   ./mvn spring-boot:run
# ============================================================
# Caddy 리버스 프록시 — 미사용 (앱에 직접 접속)
# ============================================================
# 로컬 테스트: DOMAIN=localhost (Caddy 로컬 CA 인증서 자동 생성)
# 운영:        DOMAIN=example.com (Let's Encrypt 자동 발급)
DOMAIN=localhost
USE_CADDY_REVERSE_PROXY_HTTPS=false

# ============================================================
# Server
# ============================================================
# 애플리케이션이 리스닝할 포트. 다른 서비스와 충돌 시에만 변경.
#SERVER_PORT=8080

# ============================================================
# Auth (인증) — 비활성
# ============================================================
# false → 로그인 없이 guest/admin 자동 로그인. 최초 접속 시 /setup 에서 admin 생성.
AUTH_ENABLED=false
# true → 채팅/조회는 그대로 열어두되 /admin·문서 업로드/삭제만 로그인 요구(§6.17 B안). AUTH_ENABLED=false일 때만 의미 있음.
#AUTH_MANAGEMENT_ONLY=false

# ============================================================
# LLM 라우팅 — 폐쇄망: 외부 provider 호출 전면 차단
# ============================================================
# LOCAL_ONLY → 클라우드 키가 설정돼 있어도 무시하고 LOCAL provider 만 사용.
LLM_ROUTING_MODE=LOCAL_ONLY

# ============================================================
# Local LLM provider  (app.llm.providers[0] — role: LOCAL)
# llama-server 단일 엔드포인트. 기본 포트 8080.
#   예) llama-server -m model.gguf --host 0.0.0.0 --port 8080
# ============================================================
LOCAL_LLM_URL=http://localhost:8080/v1
# llama-server 는 API 키를 무시한다. 비워두면 "no-key" 플레이스홀더가 자동 주입돼
# LOCAL provider 가 정상 등록된다.
LOCAL_LLM_KEY=
# llama-server 에 로드한 모델명 (서버의 /v1/models 응답값과 일치시킬 것).
LOCAL_LLM_MODEL=qwen2.5-7b-instruct

# ============================================================
# Embedding model  (app.embedding.*)
# 폐쇄망에서는 별도 임베딩 엔드포인트(llama-server 임베딩 모드 또는 전용 인스턴스)를 사용한다.
#   예) llama-server -m nomic-embed-text.gguf --embedding --port 8081
# EMBED_BASE_URL 을 비우면 LOCAL_LLM_URL 값이 그대로 적용된다.
#
# 경고: 인덱싱 후 EMBED_MODEL / EMBED_DIMENSIONS 변경 시 전체 재인덱싱 필요
#       (컬렉션 내 벡터 차원이 일관돼야 함).
# ============================================================
EMBED_BASE_URL=http://localhost:8081/v1
#EMBED_API_KEY=
EMBED_MODEL=nomic-embed-text-v1.5
# sqlite-vec 는 차원 자동 감지가 불가능하므로 EMBED_DIMENSIONS 가 필수.
# 임베딩 모델의 실제 출력 차원과 정확히 일치해야 한다.
#   nomic-embed-text=768, bge-m3=1024, text-embedding-3-small=1536
# 값이 틀리면 sqlite-vec insert/search 가 깨진다.
EMBED_DIMENSIONS=768

# ============================================================
# Vector store backend — sqlite-vec (외부 의존·Docker 없음)
# ============================================================
# chroma (default, Docker 필요) | sqlite-vec (외부 의존 없음)
VECTORSTORE_TYPE=sqlite-vec
# sqlite-vec 사용 시에만 필요 — vec0 로더블 확장 바이너리 절대경로.
# 공식 Maven 아티팩트가 없어 운영자가 직접 배치한다 (suffix .so/.dylib/.dll 생략 가능).
# 바이너리: https://github.com/asg017/sqlite-vec/releases (플랫폼별 loadable)
#SQLITE_VEC_EXTENSION_PATH=/opt/sqlite-vec/vec0
SQLITE_VEC_EXTENSION_PATH=./lib/win64/vec0.dll
#SQLITE_VEC_EXTENSION_PATH=./lib/macos/vec0.dylib
# 선택: load_extension 엔트리포인트 강제 (비우면 SQLite가 파일명에서 유추).
# 엔트리포인트 오류로 로드 실패 시에만 sqlite3_vec_init 지정.
#SQLITE_VEC_ENTRYPOINT=
# 선택: 벡터/FTS 테이블을 memory.db 와 분리해 별도 파일에 저장 (인덱싱 I/O 격리).
# 비우면(기본) memory.db 에 함께 저장. 전환 시 재인덱싱 필요(벡터 미이전).
SQLITE_VEC_DB_PATH=./data/vector.db



# ============================================================
# HTTP timeouts
# Used by application.properties timeout bindings.
# ============================================================
# Browser <-> server SSE idle timeout (seconds) - aborts only when no forward progress happens
#SSE_IDLE_TIMEOUT_SECONDS=120
# Browser <-> server SSE absolute timeout (seconds) - hard ceiling regardless of activity
#SSE_TIMEOUT_SECONDS=3600
#INDEXING_KEYWORD_TIMEOUT_SECONDS=180

# LLM provider HTTP timeout (seconds)
#LLM_CONNECT_TIMEOUT_SECONDS=10
#LLM_READ_TIMEOUT_SECONDS=180

# Embedding HTTP timeout (seconds)
#EMBED_CONNECT_TIMEOUT_SECONDS=10
#EMBED_READ_TIMEOUT_SECONDS=180

# Embedding token usage is tracked separately from chat (llm_usage, provider "embed:<model>").
# If the embedding server doesn't report usage, approximate input tokens as chars/4 (default true).
# Set to false to record 0 instead.
#EMBED_USAGE_FALLBACK_ENABLED=true

# Chroma HTTP timeout (seconds)
#CHROMA_CONNECT_TIMEOUT_SECONDS=5
#CHROMA_READ_TIMEOUT_SECONDS=120

# ============================================================
# Storage
# ============================================================
DATA_DIR=./data

# ============================================================
# RAG tuning
# Range guidance:
#   CHUNK_SIZE                 300  ~ 2000  (chars) — smaller = precise, larger = context-rich
#   CHUNK_OVERLAP              0    ~ 25% of CHUNK_SIZE — cross-boundary context only
#   MIN_CHUNK_SIZE             50   ~ 25% of CHUNK_SIZE — tiny-chunk merge threshold
#   SEARCH_TOP_K               2    ~ 15    — more docs = higher recall, more tokens
#   SEARCH_SIMILARITY_THRESHOLD 0.0 ~ 0.75  — min cosine similarity; 0.0 = accept all
#   SEARCH_MULTIQUERY_ENABLED  true/false   — expand query via LLM before search
#   SEARCH_MULTIQUERY_MIN_LENGTH 0  ~ 20    — skip expansion for short queries (0 = always expand)
#   SEARCH_HYBRID_ENABLED      true/false   — add BM25 (FTS5) keyword axis to RRF (re-index required)
#   SEARCH_RETRY_ESCALATE      true/false   — grow candidate pool on retry ×(retryCount+1), capped ×3
#   SEARCH_RERANK_ENABLED      true/false   — LLM reranking after RRF (adds 1 LLM call/turn)
#   SEARCH_CANDIDATE_MULTIPLIER 2   ~ 5     — pool size for reranking: topK × N
#   SEARCH_RRF_KEYWORD_WEIGHT   0.5  ~ 3.0  — BM25 axis weight (vector axes are always group-normalized)
#   SEARCH_RRF_K                20   ~ 100  — RRF rank-fusion constant (60 = original paper default)
#   SEARCH_QUERY_EMBED_CACHE_ENABLED true/false — cache query embeddings (Caffeine, in-memory)
#   SEARCH_QUERY_EMBED_CACHE_MAX_SIZE   100 ~ 5000 — cache entry cap
#   SEARCH_QUERY_EMBED_CACHE_TTL_SECONDS 60 ~ 3600 — cache entry TTL (write-based)
#   MAX_RETRY_COUNT            0    ~ 4     — retrieval re-attempt limit
# ============================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=300
SEARCH_TOP_K=7
#SEARCH_SIMILARITY_THRESHOLD=0.0
#SEARCH_MULTIQUERY_ENABLED=true
#SEARCH_MULTIQUERY_MIN_LENGTH=0
#SEARCH_HYBRID_ENABLED=false
#SEARCH_RETRY_ESCALATE=true
#SEARCH_RERANK_ENABLED=false
#SEARCH_CANDIDATE_MULTIPLIER=3
#SEARCH_RRF_KEYWORD_WEIGHT=1.0
#SEARCH_RRF_K=60
#SEARCH_QUERY_EMBED_CACHE_ENABLED=true
#SEARCH_QUERY_EMBED_CACHE_MAX_SIZE=500
#SEARCH_QUERY_EMBED_CACHE_TTL_SECONDS=600
MAX_RETRY_COUNT=2

# ============================================================
# LLM response parameters
#   LLM_MAX_TOKENS    1000 ~ 32000 — max output tokens per response;
#                                    increase for long summaries / complex answers
#   LLM_TEMPERATURE   0.0  ~ 2.0  — 0.0 = deterministic (recommended for RAG),
#                                    higher = more creative / varied responses
# ============================================================
#LLM_MAX_TOKENS=8000
#LLM_TEMPERATURE=0.0

# ============================================================
# Indexing parallelism
# Range guidance:
#   INDEXING_MAX_FILES     1 ~ 8  — parallel file indexing workers
#   INDEXING_MAX_LLM       1 ~ 16 — parallel LLM calls during indexing
# 폐쇄망 단일 llama-server 는 동시 요청 처리량이 낮을 수 있으므로 보수적으로 설정 권장.
# ============================================================
# INDEXING_MAX_FILES=4
# INDEXING_MAX_LLM=4

# ============================================================
# Log levels
#   INFO  — production default
#   DEBUG — agent flow / routing decisions / prompt 내용 포함 (운영 사용 금지)
#   TRACE — full HTTP request/response bytes (very verbose during SSE streaming)
# 런타임 변경(재시작 불필요):
#   POST /actuator/loggers/com.example.ragagent  {"configuredLevel":"DEBUG"}
# ============================================================
#LOGGING_LEVEL=INFO
#SPRING_SECURITY_LOGGING_LEVEL=WARN

# ============================================================
# Multi-LLM Provider routing  (application.properties snippet)
#
# 폐쇄망 구성에서는 LOCAL provider 하나만 등록하면 충분하다.
# 아래 블록을 src/main/resources/application.properties 에 복사해 사용한다.
# LLM_ROUTING_MODE=LOCAL_ONLY 가 설정돼 있으면 외부 provider 는 등록돼 있어도 호출되지 않는다.
# 자세한 내용은 documents/LLM_ROUTING.md 참고.
# ============================================================
# app.llm.default-routing-mode=LOCAL_ONLY
# app.llm.circuit-breaker-minutes=2

# ── [LOCAL] llama-server — 모든 task type 처리 ─────────────────────────
# app.llm.providers[0].name=local
# app.llm.providers[0].base-url=${LOCAL_LLM_URL:http://localhost:8080/v1}
# app.llm.providers[0].api-key=${LOCAL_LLM_KEY:}
# app.llm.providers[0].model=${LOCAL_LLM_MODEL:qwen2.5-7b-instruct}
# app.llm.providers[0].type=BOTH
# app.llm.providers[0].role=LOCAL
# app.llm.providers[0].priority=0
