# ============================================================
# 폐쇄망(air-gapped) / no-docker 구성 예시
# ------------------------------------------------------------
#   - Vector store : sqlite-vec (ChromaDB·Docker 불필요)
#   - LLM          : llama-server 로컬 단일 엔드포인트만 사용 (외부 호출 전면 차단)
#   - Auth         : 비활성 (guest/admin 자동 로그인)
#   - Reverse proxy: 미사용
#
# 사용법:
#   cp .env.example.sqlite .env
#   # SQLITE_VEC_EXTENSION_PATH / EMBED_DIMENSIONS / 모델명을 환경에 맞게 수정
#   ./mvn spring-boot:run
# ============================================================
# Caddy 리버스 프록시 — 미사용 (앱에 직접 접속)
# ============================================================
# 로컬 테스트: DOMAIN=localhost (Caddy 로컬 CA 인증서 자동 생성)
# 운영:        DOMAIN=example.com (Let's Encrypt 자동 발급)
DOMAIN=localhost
USE_CADDY_REVERSE_PROXY_HTTPS=false

# ============================================================
# 서버
# ============================================================
# 애플리케이션이 리스닝할 포트. 다른 서비스와 충돌 시에만 변경.
#SERVER_PORT=8080

# ============================================================
# Auth (인증) — 비활성
# ============================================================
# false → 로그인 없이 guest/admin 자동 로그인. 최초 접속 시 /setup 에서 admin 생성.
AUTH_ENABLED=false
# true → 채팅/조회는 그대로 열어두되 /admin·문서 업로드/삭제만 로그인 요구. AUTH_ENABLED=false일 때만 의미 있음.
AUTH_MANAGEMENT_ONLY=true

# 접속자별 채팅 개인화 — AUTH_ENABLED=false일 때만 의미 있음.
# 이 구성은 여러 사람이 사내망에서 같은 서버에 접속하는 것을 전제하므로 hybrid 를 기본으로 켜 둔다.
# shared(프로퍼티 기본값)로 두면 전 방문자가 게스트 계정 하나를 공유해 사이드바 대화 목록·이력이
# 전부 섞여 보인다. 혼자 쓰는 서버라면 아래를 주석 처리하거나 shared 로 바꾸면 된다.
# (업로드된 문서는 어느 값이든 공유 — 개인화 대상은 채팅 스레드·이력·좋아요 소유권뿐)
#   shared  모두가 하나의 게스트를 공유 (프로퍼티 기본값)
#   ip      접속 IP 해시. 쿠키 불필요하나 NAT 환경에선 뭉치고 DHCP 갱신 시 이력 유실
#   cookie  장수 HttpOnly 쿠키만 사용. 정확하지만 쿠키 차단 시 매번 새 방문자
#   hybrid  쿠키 우선 + 없으면 IP로 유도해 쿠키에 저장 (권장 — IP 변경·쿠키 삭제 모두 견딤)
# 알 수 없는 값은 shared로 폴백한다. 실제 적용값은 기동 로그의
# "[GUEST_ID] 방문자 식별 전략: ..." 줄에서 확인할 것. 자세한 내용은 OPERATOR_MANUAL.md §9.4.3.
# ⚠ 이 설정을 바꾸기 전에 쌓인 대화는 예전 게스트 id에 묶여 있어 보이지 않게 된다
#   (삭제되지는 않으며 원래 값으로 되돌리면 다시 보임).
AUTH_GUEST_IDENTITY=hybrid

# X-Forwarded-For를 실제 클라이언트 IP로 신뢰할지 여부 (속도 제한 + 방문자 식별 공용).
# 이 폐쇄망 구성은 리버스 프록시가 없는 직접 노출이므로 false가 정답이다 — 헤더는 클라이언트가
# 임의로 넣을 수 있어, 신뢰하면 매 요청 헤더만 바꿔 per-IP 속도 제한을 무한 우회하거나
# 다른 방문자의 게스트 신원을 가로채 대화 목록을 열람할 수 있다.
# ★ 앞단에 Caddy/nginx(HTTPS)를 두는 구성으로 바꾸면 반드시 true 로 변경할 것 — 그러지 않으면
#   위 hybrid 가 첫 방문자를 식별할 때 보는 IP가 전부 프록시 주소라 전원이 한 명으로 뭉친다.
#   (OPERATOR_MANUAL.md §4.5-4 "전체 예시 — 폐쇄망 HTTPS + 접속자별 채팅 분리" 참고)
TRUST_FORWARDED_FOR=false

# ============================================================
# LLM 라우팅 — 폐쇄망: 외부 provider 호출 전면 차단
# ============================================================
# LOCAL_ONLY → 클라우드 키가 설정돼 있어도 무시하고 LOCAL provider 만 사용.
LLM_ROUTING_MODE=LOCAL_ONLY

# 시작 시 검증(G3): 아래에서 URL을 설정한 각 LOCAL LLM에 대해 기동 시 GET {url}/models를 호출해
# 접속 가능·모델명 일치를 확인한다. 실패하면 애플리케이션이 아예 기동되지 않는다(런타임 폴백이
# 아님) — LOCAL_ONLY 폐쇄망 구성은 외부 fallback이 없으므로 특히 중요하다. 로컬 서버가 앱보다
# 늦게 뜨는 배포 순서 레이스가 있을 때만 false로 끌 것.
#LLM_VERIFY_LOCAL_MODELS_ON_STARTUP=true

# ============================================================
# 로컬 LLM 1  (app.llm.providers[1] — role: LOCAL, priority 1)
# llama-server 단일 엔드포인트. 기본 포트 8080.
#   예) llama-server -m model.gguf --host 0.0.0.0 --port 8080
# 필수 — LOCAL_LLM_URL이 비어 있으면 이 provider는 통째로 비활성화된다(더 이상 앱이
# 자체적으로 로컬호스트로 폴백하지 않음). 값을 설정하면 위 G3 검증 대상이 된다 — 서버가 안
# 떠 있거나 LOCAL_LLM_MODEL이 실제 모델명과 다르면 기동이 실패한다.
# ============================================================
#LOCAL_LLM_URL=http://localhost:8092/v1
LOCAL_LLM_URL=http://localhost:1234/v1
# LOCAL_LLM는 API 키를 비워두면 "no-key" 플레이스홀더가 자동 주입돼 LOCAL provider 가 정상 등록된다.
#LOCAL_LLM_KEY=
# llm-server 에 로드한 모델명 (서버의 /v1/models 응답값과 일치시킬 것).
LOCAL_LLM_MODEL=google/gemma-4-e2b
# 이 provider가 처리할 작업 유형 (app.llm.providers[1].type):
#   MICRO_TEXT | LIGHT_TEXT | TEXT | VISION | LIGHT_BOTH | BOTH. 기본 BOTH(전 작업 처리).
#LOCAL_LLM_TYPE=BOTH

# ============================================================
# 로컬 LLM 2  (app.llm.providers[2] — role: LOCAL, priority 1, §6.21)
# Local LLM 1과 동일한 모델을 서빙하는 두 번째 물리 서버. role/priority가 동일해 LlmRouter가
# 잔여 permit이 더 많은(least-in-flight) 쪽으로 자동 분산한다(OPERATOR_MANUAL.md §5.4 예제 5/7).
# 선택 사항 — LOCAL_LLM_URL_2를 비워두면 이 provider는 통째로 비활성화된다(회귀 0, Local LLM 1
# 단독으로 동작). 값을 설정하면 G3 검증 대상이 되어, 서버가 안 떠 있거나 모델명이 다르면
# "한 번 실패 후 자동 폴백"이 아니라 애플리케이션 기동 자체가 실패한다.
# ============================================================
#LOCAL_LLM_URL_2=http://localhost:8082/v1
# 키는 불필요(비우면 no-key 치환). 모델명은 미설정 시 LOCAL_LLM_MODEL 값을 그대로 사용.
#LOCAL_LLM_KEY_2=
#LOCAL_LLM_MODEL_2=google/gemma-4-e2b
# Local LLM 2 작업 유형 (app.llm.providers[2].type). 값 집합은 LOCAL_LLM_TYPE과 동일. 보통 BOTH.
#LOCAL_LLM_TYPE_2=BOTH

# ============================================================
# 소형/고속 로컬 LLM  (app.llm.providers[0] — role: LOCAL, type: MICRO_TEXT, §6.21)
# 추론이 필요 없는 잡무(키워드+맥락 추출·대화 요약·제목 생성·MultiQuery 쿼리 확장)를
# LOCAL_LLM_URL과 별도 포트/장비의 소형(~500MB) 모델로 오프로딩해 잡무가 답변용 큰 모델의
# 동시성 슬롯을 잠식하지 않게 한다.
# 선택 사항 — LOCAL_FAST_LLM_URL을 비워두면 이 provider는 통째로 비활성화된다(MICRO_TEXT는
# 큰 LOCAL 모델이 흡수. 단 대화 요약만은 흡수하지 않고 생략 — 부가 기능이 답변용 모델의 슬롯을
# 잠식하면 안 되므로, 채팅은 원본 history 폴백으로 동작). 값을 설정하면 G3 검증 대상이 되어, 서버가 안 떠 있거나
# 모델명이 다르면 애플리케이션 기동 자체가 실패한다(런타임 폴백이 아님).
# 상세: OPERATOR_MANUAL.md §5.4 예제 6.
# ============================================================
# 기본값(미설정 = provider 비활성)에 맞춰 주석 처리해 둔다 — 첫 기동에 필요한 서버는
# LOCAL_LLM_URL 하나뿐. 해당 포트에 소형 모델을 실제로 띄운 뒤에만 주석을 해제할 것
# (URL만 설정하고 서버가 없으면 G3 검증에 걸려 애플리케이션이 아예 기동되지 않는다).
#LOCAL_FAST_LLM_URL=http://localhost:8090/v1
# LOCAL_LLM_KEY와 마찬가지로 로컬 엔드포인트는 보통 키가 불필요.
#LOCAL_FAST_LLM_KEY=
#LOCAL_FAST_LLM_MODEL=Qwen3.5-0.8B-Q4_K_M.gguf

# ============================================================
# 임베딩 모델  (app.embedding.*)
# 폐쇄망에서는 별도 임베딩 엔드포인트(llama-server 임베딩 모드 또는 전용 인스턴스)를 사용한다.
#   예) llama-server -m nomic-embed-text.gguf --embedding --port 8081
# EMBED_BASE_URL 을 비우면 LOCAL_LLM_URL 값이 그대로 적용된다.
#
# 경고: 인덱싱 후 EMBED_MODEL / EMBED_DIMENSIONS 변경 시 전체 재인덱싱 필요
#       (컬렉션 내 벡터 차원이 일관돼야 함).
# ============================================================
EMBED_BASE_URL=http://localhost:8081/v1
#EMBED_API_KEY=your-embeding-llm-api-key-here
EMBED_MODEL=nomic-embed-text-v1.5
# sqlite-vec 는 차원 자동 감지가 불가능하므로 EMBED_DIMENSIONS 가 필수.
# 임베딩 모델의 실제 출력 차원과 정확히 일치해야 한다.
#   nomic-embed-text=768, bge-m3=1024, text-embedding-3-small=1536
# 값이 틀리면 sqlite-vec insert/search 가 깨진다.
EMBED_DIMENSIONS=768

# 청크당 문자 상한(임베딩 서버의 물리 배치 한도 대응). 0 = 사용 안 함(기본).
# 서버가 "input (N tokens) is too large ... (current batch size: 512)" 로 거부할 때만 설정
# — 예: ~450 이면 512-token 배치 안에 들어간다. 우선 서버 배치를 키우고(llama-server -b/-ub),
# 이 값은 최후의 안전망으로 쓸 것. OPERATOR_MANUAL §8 참조.
#EMBED_MAX_CHUNK_CHARS=0
# §6.21 E1 — 같은 모델·같은 차원을 서빙하는 추가 임베딩 엔드포인트(쉼표 구분). 비우면(기본) 위
# 엔드포인트 하나만 사용. 서로 다른 모델을 섞으면 벡터 인덱스가 오염된다.
#EMBED_ADDITIONAL_BASE_URLS=
# §6.21 E2 — 한 문서 인덱싱 안에서의 병렬 서브배치 임베딩. 1 = 직렬(기본).
# 대략 (엔드포인트 수 × 엔드포인트당 병렬) 로 맞추면 큰 파일 하나로도 E1 엔드포인트를 모두 채운다.
#EMBED_MAX_CONCURRENT_BATCHES=1

# ============================================================
# Vector store backend — sqlite-vec (외부 의존·Docker 없음)
# ============================================================
# chroma (default, Docker 필요) | sqlite-vec (외부 의존 없음)
VECTORSTORE_TYPE=sqlite-vec
# sqlite-vec 사용 시에만 필요 — vec0 로더블 확장 바이너리 절대경로.
# 공식 Maven 아티팩트가 없어 운영자가 직접 배치한다 (suffix .so/.dylib/.dll 생략 가능).
# 바이너리: https://github.com/asg017/sqlite-vec/releases (플랫폼별 loadable)
# 이 저장소에 동봉된 바이너리는 lib/macos/vec0.dylib 하나뿐 — 다른 플랫폼은 위 릴리스에서
# 내려받아 경로를 맞출 것(없는 경로를 가리키면 기동 자체가 실패한다).
SQLITE_VEC_EXTENSION_PATH=./lib/macos/vec0.dylib
#SQLITE_VEC_EXTENSION_PATH=./lib/win64/vec0.dll
#SQLITE_VEC_EXTENSION_PATH=/opt/sqlite-vec/vec0
# 선택: load_extension 엔트리포인트 강제 (비우면 SQLite가 파일명에서 유추).
# 엔트리포인트 오류로 로드 실패 시에만 sqlite3_vec_init 지정.
#SQLITE_VEC_ENTRYPOINT=
# 선택: 벡터/FTS 테이블을 memory.db 와 분리해 별도 파일에 저장 (인덱싱 I/O 격리).
# 비우면(기본) memory.db 에 함께 저장. 전환 시 재인덱싱 필요(벡터 미이전).
SQLITE_VEC_DB_PATH=./data/vector.db

# ============================================================
# HTTP 타임아웃
# application.properties 의 타임아웃 바인딩에서 사용한다.
# ============================================================
# 브라우저 <-> 서버 SSE 유휴 타임아웃(초) — 진행이 전혀 없을 때만 중단한다
#SSE_IDLE_TIMEOUT_SECONDS=300
# 브라우저 <-> 서버 SSE 절대 타임아웃(초) — 활동 여부와 무관한 상한
#SSE_TIMEOUT_SECONDS=7200
#INDEXING_KEYWORD_TIMEOUT_SECONDS=600

# LLM 프로바이더 HTTP 타임아웃(초)
#LLM_CONNECT_TIMEOUT_SECONDS=10
#LLM_READ_TIMEOUT_SECONDS=600

# 질의 경로의 프로바이더별 동시성 게이트(LLM 서버의 --parallel 값과 맞출 것)와,
# 슬롯을 기다리는 최대 시간(초). 초과하면 계속 대기하지 않고 즉시 429로 실패한다.
#LLM_DEFAULT_PROVIDER_CONCURRENCY=3
#LLM_PERMIT_WAIT_TIMEOUT_SECONDS=60

# 임베딩 HTTP 타임아웃(초)
#EMBED_CONNECT_TIMEOUT_SECONDS=10
#EMBED_READ_TIMEOUT_SECONDS=180

# 임베딩 토큰 사용량은 채팅과 분리해 집계한다(llm_usage 의 프로바이더 "embed:<model>").
# 임베딩 서버가 사용량을 반환하지 않으면 입력 토큰을 글자수/4 로 근사한다(기본 true).
# false 로 두면 근사 대신 0 으로 기록한다.
#EMBED_USAGE_FALLBACK_ENABLED=true

# Chroma HTTP 타임아웃(초)
#CHROMA_CONNECT_TIMEOUT_SECONDS=5
#CHROMA_READ_TIMEOUT_SECONDS=120

# ============================================================
# 저장 경로
# ============================================================
DATA_DIR=./data

# ============================================================
# RAG 튜닝
# 아래 활성 값은 모두 application.properties 기본값을 그대로 적은 것이다(주석 줄도 기본값 표기).
# 권장 범위:
#   CHUNK_SIZE                 300  ~ 2000  (글자) — 작을수록 정밀, 클수록 맥락 풍부
#   CHUNK_OVERLAP              0    ~ CHUNK_SIZE의 25% — 경계를 넘는 맥락 확보 용도.
#                              기본 0 — 섹션 기반 분할이 이미 각 청크에 소제목·부모 breadcrumb를
#                              달아주므로 문자 겹침은 대부분 중복이고, 0이어야 문서 내보내기의
#                              겹침 제거(ChunkReassembler의 유일한 휴리스틱 단계)가 no-op이 된다.
#   MIN_CHUNK_SIZE             50   ~ CHUNK_SIZE의 1/3 — 너무 작은 청크를 병합하는 기준값.
#                              반드시 CHUNK_SIZE보다 충분히 작아야 한다: 이 값이 CHUNK_SIZE를 넘으면
#                              분할된 모든 조각이 기준 미달이라 앞 청크로 되접혀, 문서 전체가
#                              청크 1개로 붕괴한다(검색 단위 소멸).
#   SEARCH_TOP_K               2    ~ 15    — 많을수록 재현율은 오르고 토큰 소모도 늘어남
#   SEARCH_SIMILARITY_THRESHOLD 0.0 ~ 0.75  — 최소 코사인 유사도; 0.0 = 전부 허용
#   SEARCH_MULTIQUERY_ENABLED  true/false   — 검색 전 LLM으로 질의를 확장
#   SEARCH_MULTIQUERY_MIN_LENGTH 0  ~ 20    — 짧은 질의는 확장 생략 (0 = 항상 확장)
#   SEARCH_HYBRID_ENABLED      true/false   — RRF에 BM25(FTS5) 키워드 축 추가 (기본 true, §10.7.2. FTS5/하이브리드 도입 이전 문서가 아니라면 재인덱싱 불필요)
#   SEARCH_RETRY_ESCALATE      true/false   — 재시도 시 후보 풀을 ×(retryCount+1)로 확대, 최대 ×3
#   SEARCH_RERANK_ENABLED      true/false   — RRF 이후 LLM 재순위 (턴당 LLM 호출 1회 추가)
#   SEARCH_CANDIDATE_MULTIPLIER 2   ~ 5     — 재순위용 후보 풀 크기: topK × N
#   SEARCH_TAG_CANDIDATE_MULTIPLIER 1 ~ 5   — 태그 선택 시 후보 풀 확대: max(candidateK, topK × N)
#   SEARCH_RRF_KEYWORD_WEIGHT   0.5  ~ 3.0  — BM25 축 가중치 (벡터 축은 항상 그룹 정규화됨)
#   SEARCH_RRF_K                20   ~ 100  — RRF 순위 융합 상수 (60 = 원 논문 기본값)
#   SEARCH_QUERY_EMBED_CACHE_ENABLED true/false — 질의 임베딩 캐시 (Caffeine, 인메모리)
#   SEARCH_QUERY_EMBED_CACHE_MAX_SIZE   100 ~ 5000 — 캐시 항목 수 상한
#   SEARCH_QUERY_EMBED_CACHE_TTL_SECONDS 60 ~ 3600 — 캐시 항목 TTL (기록 시점 기준)
#   MAX_RETRY_COUNT            0    ~ 4     — 검색 재시도 횟수 상한
# ============================================================
CHUNK_SIZE=1500
CHUNK_OVERLAP=0
MIN_CHUNK_SIZE=500
SEARCH_TOP_K=8
#SEARCH_SIMILARITY_THRESHOLD=0.0
#SEARCH_MULTIQUERY_ENABLED=true
#SEARCH_MULTIQUERY_MIN_LENGTH=15
#SEARCH_HYBRID_ENABLED=true
#SEARCH_RETRY_ESCALATE=true
#SEARCH_RERANK_ENABLED=false
#SEARCH_CANDIDATE_MULTIPLIER=3
#SEARCH_TAG_CANDIDATE_MULTIPLIER=2
#SEARCH_RRF_KEYWORD_WEIGHT=1.0
#SEARCH_RRF_K=60
#SEARCH_QUERY_EMBED_CACHE_ENABLED=true
#SEARCH_QUERY_EMBED_CACHE_MAX_SIZE=500
#SEARCH_QUERY_EMBED_CACHE_TTL_SECONDS=600
MAX_RETRY_COUNT=2
# curated-Q&A RRF axis (좋아요 답변을 별도 검색 축으로 승격).
# enabled=false면 해당 축 검색을 아예 건너뛴다. weight는 flat(벡터 축들과 group-normalize 안 됨).
#SEARCH_CURATED_QA_ENABLED=true
#SEARCH_CURATED_QA_WEIGHT=1.5

# ============================================================
# LLM 응답 파라미터
#   LLM_MAX_TOKENS    1000 ~ 32000 — 응답당 최대 출력 토큰 수.
#                                    긴 요약이나 복잡한 답변이 필요하면 올린다
#   LLM_TEMPERATURE   0.0  ~ 0.3  — 일반/RAG 대화형 호출(분류/답변/평가/재랭킹).
#                                    0.0 = 결정적(RAG에 권장). /settings에서 재시작 없이
#                                    변경 가능(다음 호출부터 적용).
# ============================================================
#LLM_MAX_TOKENS=6000
#LLM_TEMPERATURE=0.0
# Direct(meta) 답변 전용 — RAG 없는 인사/잡담에만 적용. 범위 0.0~0.2.
# /settings에서 재시작 없이 변경 가능(다음 호출부터 적용).
#DIRECT_LLM_TEMPERATURE=0.1
# 인덱싱/백그라운드 전용 — 키워드 추출, MD 교정, txt→md 구조화, 이미지 설명/분류, 스레드 제목 생성,
# 대화 요약 등 모든 ungated 백그라운드 호출에 적용. 대화형이 아닌 추출/분류 작업이라
# LLM_TEMPERATURE/DIRECT_LLM_TEMPERATURE 설정과 무관하게 0에 가깝게 유지. 범위 0.0~1.0.
# /settings에서 재시작 없이 변경 가능(다음 호출부터 적용).
#LLM_INDEXING_TEMPERATURE=0.0

# ============================================================
# 대화 메모리 / 요약
#   MEMORY_FETCH_LIMIT_TURNS       문자 예산(LLM_MAX_TOKENS × 0.5, 최소 1000)으로 잘라내기 전에
#                                  가져올 최근 턴 수
#   SUMMARY_MAX_CACHED_THREADS     요약 캐시(LRU) 크기 — 동시에 따뜻하게 유지할 스레드 수
#   SUMMARY_MAX_SUMMARY_CHARS      생성 요약문 길이 상한
#   SUMMARY_RECENT_RAW_TURNS       요약 뒤에 원문 그대로 덧붙일 최근 턴 수
#   SUMMARY_PRECOMPUTE_TTL_SECONDS 같은 스레드의 중복 사전계산 억제 창
# 주의: 요약 자체는 MICRO_TEXT provider(LOCAL_FAST_LLM_URL)가 등록됐을 때만 동작한다.
# 없으면 요약을 생략하고 원본 history로 폴백한다(답변용 모델의 슬롯을 잠식하지 않기 위함).
# ============================================================
#MEMORY_FETCH_LIMIT_TURNS=10
#SUMMARY_MAX_CACHED_THREADS=3
#SUMMARY_MAX_SUMMARY_CHARS=2000
#SUMMARY_RECENT_RAW_TURNS=2
#SUMMARY_PRECOMPUTE_TTL_SECONDS=15

# ============================================================
# 인덱싱 병렬도
# 권장 범위:
#   INDEXING_MAX_FILES     1 ~ 8  — 동시에 인덱싱할 파일 수
#   INDEXING_MAX_LLM       1 ~ 16 — 인덱싱 중 동시 LLM 호출 수
# 폐쇄망 단일 llama-server 는 동시 요청 처리량이 낮을 수 있으므로 보수적으로 설정 권장.
# ============================================================
#INDEXING_MAX_FILES=1
#INDEXING_MAX_LLM=3
# 키워드+맥락 추출 LLM 호출 하나에 묶을 청크 수. 1 = 배치 없음(청크당 1회).
# 늘리면 왕복은 줄지만 소형 로컬 모델이 섹션 형식을 자주 흐트러뜨려 TF 폴백으로 떨어진다.
#INDEXING_KEYWORD_BATCH_SIZE=2
# MD 교정 LLM이 언어를 알 수 없는 코드/로그/CLI 출력을 펜스로 감쌀 때 사용할 태그.
# java/bash/sql만 허용되며 그 외 값(미설정 포함)은 java로 폴백.
#MD_CORRECTION_DEFAULT_CODE_LANGUAGE=java

# ============================================================
# PPTX 이미지 추출 튜닝 (PptxImageExtractor)
#   PPTX_IMAGE_MIN_SHAPE_DIMENSION_PT       30pt — 긴 변이 이 값보다 작은 도형은 아이콘·구분선으로
#                                                   보고 건너뛴다
#   PPTX_IMAGE_CLUSTER_PROXIMITY_PADDING_PT 5pt  — 도형들을 하나의 묶음 이미지로 클러스터링할지
#                                                   겹침을 판정하기 전에 바깥으로 주는 여백.
#                                                   RASTERIZE_SHAPES 값과 무관하게 적용되며,
#                                                   MERGE_ANNOTATED_PICTURES에서 느슨한 도형이
#                                                   사진·표 앵커와 겹치는지 판정할 때도 쓰인다.
#   PPTX_IMAGE_MERGE_ANNOTATED_PICTURES     true/false — true(기본): 사진도 근접 클러스터링에
#                                                   참여해, 사진 위나 근처에 그린 주석(원·화살표·
#                                                   말풍선)이 사진과 하나의 합성 이미지로 병합된다.
#                                                   false: 사진은 클러스터링에 참여하지 않으며
#                                                   PowerPoint에서 실제로 그룹(Ctrl+G)한 것만 병합.
#   PPTX_IMAGE_RASTERIZE_SHAPES             true/false — false(기본): 서로 겹친 느슨한 도형들을
#                                                   하나의 다이어그램 이미지로 병합하지 않는다
#                                                   (단독 도형 하나는 래스터화하지 않음).
#                                                   true: 기존 union-find 클러스터링 동작(겹친
#                                                   느슨한 도형들 → 이미지 1장). 그룹·SmartArt,
#                                                   표+도형, 사진+주석 합성은 이 값과 무관하게
#                                                   항상 유지된다.
#PPTX_IMAGE_MIN_SHAPE_DIMENSION_PT=30
#PPTX_IMAGE_CLUSTER_PROXIMITY_PADDING_PT=5
#PPTX_IMAGE_MERGE_ANNOTATED_PICTURES=true
#PPTX_IMAGE_RASTERIZE_SHAPES=false

# PPTX 변환 시점의 중복·목차 슬라이드 제거 (PptxToMarkdownConverter)
#   PPTX_REMOVE_DUPLICATE_SLIDES  true/false — true(기본): 이미지가 없는 슬라이드 중 정규화된 본문이
#                                   앞선 슬라이드와 완전히 같거나(첫 번째만 남김), 불릿이 대부분 다른
#                                   슬라이드들의 제목 나열인 경우(목차/agenda 슬라이드) 삭제한다.
#                                   이미지가 있는 슬라이드는 절대 삭제하지 않으며, 남은 슬라이드의
#                                   [페이지: N] 번호도 영향받지 않는다. false: 모든 슬라이드 유지.
#PPTX_REMOVE_DUPLICATE_SLIDES=true
#   PPTX_DROP_DIVIDER_SLIDES      true/false — true(기본): 본문도 이미지도 없이 제목만 있는 슬라이드는
#                                   그 제목이 섹션 구분처럼 읽힐 때 삭제한다(번호·라벨형 "3장"/"PART 2"/
#                                   "부록 A", 구분 키워드 "목차"/"개요", 또는 짧은 명사구).
#                                   문장형 키 메시지 제목(다·니다·요·. 로 끝나거나 은/는/이/가/을/를
#                                   조사가 있는 경우)은 유지한다.
#                                   false: 제목만 있는 슬라이드도 유지. 본문·이미지 슬라이드는 무관.
#PPTX_DROP_DIVIDER_SLIDES=true
#   PPTX_DROP_REDUNDANT_TITLE_SLIDES true/false — true (기본): 이미지·도형그룹/다이어그램/차트/표가
#                                   없고 짧은 제목 한 줄뿐인 슬라이드를, 그 제목이 바로 다음 슬라이드
#                                   안에 그대로 등장하면 삭제한다("예고 제목" 슬라이드). 마지막
#                                   슬라이드는 비교 대상이 없으므로 영향 없음.
#PPTX_DROP_REDUNDANT_TITLE_SLIDES=true
#   PPTX_DROP_ENDING_SLIDE        true/false — true (기본): 마지막 슬라이드에 이미지가 없고 내용이
#                                   종료 표지(끝/END/The End/감사합니다)와 그 외 10자 이내뿐이면 삭제.
#PPTX_DROP_ENDING_SLIDE=true

# ============================================================
# 이미지 설명 / OCR (Vision LLM enrichment)
#   IMAGE_DESCRIPTION_ENABLED  true/false — LazyVisionService on/off. @ConditionalOnProperty 빈
#                              게이트라서 기동 시점 값만 반영된다(재시작 필요). false면 질의 시점
#                              이미지 설명을 아예 하지 않는다.
#   IMAGE_OCR_ENABLED          true/false — 스캔 PDF·이미지 전용 페이지의 Tesseract OCR.
#                              동일한 구조적 빈 게이트(OcrService).
#   IMAGE_OCR_TESSDATA_PATH    tessdata 디렉터리 절대경로. 비우면(기본) TESSDATA_PREFIX 환경변수
#                              또는 시스템 기본 경로를 따른다. 폐쇄망에서 OCR을 쓸 경우 여기서
#                              언어 데이터 위치를 직접 지정할 것.
#   IMAGE_CLASSIFY_TYPE        true/false — 설명 전에 이미지 유형(다이어그램/스크린샷/사진 등)을
#                              먼저 분류해 설명 프롬프트를 맞춘다.
#   DOCX_EMF_CONVERT           true/false — DOCX의 EMF 이미지를 Batik으로 래스터화.
#   DOCX_WMF_CONVERT           true/false — WMF는 LibreOffice(soffice)가 PATH에 있어야 해서 기본
#                              false. 끄면 해당 이미지는 [이미지(변환불가): ...] 마커로 남는다.
# ============================================================
#IMAGE_DESCRIPTION_ENABLED=true
#IMAGE_OCR_ENABLED=true
#IMAGE_OCR_TESSDATA_PATH=
#IMAGE_CLASSIFY_TYPE=true
#DOCX_EMF_CONVERT=true
#DOCX_WMF_CONVERT=false

# ============================================================
# 요청 제한(사용자별 토큰 버킷) / 감사 로그
# 버킷이 비면 429 + RAG-RATE-001 + Retry-After 를 반환한다. 모두 재시작 필요.
# 감사 로그의 크기/보관 값은 Logback AUDIT_FILE appender의 롤링 기준이기도 하다.
# ============================================================
#RATE_LIMIT_ENABLED=true
#RATE_LIMIT_CHAT_PER_MINUTE=60
#RATE_LIMIT_UPLOAD_PER_MINUTE=10
#RATE_LIMIT_SYNC_PER_MINUTE=3
#RATE_LIMIT_IMAGE_PER_MINUTE=300
#RATE_LIMIT_DEFAULT_PER_MINUTE=120
#AUDIT_ENABLED=true
#AUDIT_MAX_FILE_SIZE=10MB
#AUDIT_MAX_HISTORY_DAYS=7
#AUDIT_TOTAL_SIZE_CAP=100MB

# ============================================================
# DOCX 이미지 추출 튜닝 (DocxAnnotationShapeMerger)
#   DOCX_IMAGE_MERGE_ANNOTATED_SHAPES  true/false — [실험적] false(기본): 사진을 항상 원본 그대로
#                                        단독 추출한다. true: 같은 문단 안에 있는 사진과 레거시 VML
#                                        도형(v:rect/v:oval/v:roundrect/v:line — 예: 스크린샷 위에
#                                        그린 강조 원이나 화살표)을 하나의 이미지로 합성한다.
#                                        PPTX와 달리 실제 기하학적 겹침을 판정하지 않는다 — POI의
#                                        WordprocessingML 모델에는 도형 좌표도 렌더러도 없어서
#                                        "같은 문단"이라는 근사를 쓰기 때문이다. 그래서 합성된 도형의
#                                        위치가 문서상 실제 위치와 어긋날 수 있다.
#                                        최신 DrawingML 도형(삽입 > 도형)은 지원하지 않으며
#                                        레거시 VML 폴백만 처리한다.
# ============================================================
#DOCX_IMAGE_MERGE_ANNOTATED_SHAPES=false

# ============================================================
# 로그 레벨
#   INFO  — 운영 기본값
#   DEBUG — 에이전트 흐름 / 라우팅 결정 / prompt 내용 포함 (운영 사용 금지)
#   TRACE — HTTP 요청·응답 바이트 전체 (SSE 스트리밍 중 매우 장황함)
# 런타임 변경(재시작 불필요):
#   POST /actuator/loggers/com.example.ragagent  {"configuredLevel":"DEBUG"}
# ============================================================
#LOGGING_LEVEL=INFO
#SPRING_SECURITY_LOGGING_LEVEL=WARN
