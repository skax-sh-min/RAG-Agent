    <groupId>com.example</groupId>
    <artifactId>rag-agent</artifactId>
    <version>0.6.0-SNAPSHOT</version>
    <name>rag-agent</name>
    <description>RAG Multi-Agent System with Spring AI (converted from Python/LangGraph)</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.1.0</spring-ai.version>
        <!-- 앱 jar 매니페스트 Min-Launcher-Protocol — 이 버전이 요구하는 최소 런처 세대(아래 maven-jar-plugin default-jar 설명) -->
        <min.launcher.protocol>1</min.launcher.protocol>

        <!-- sqlite-vec 로더블 확장 — 버전의 유일한 출처. 빌드(maven-antrun-plugin, generate-resources)가 이 버전의 릴리즈 파일을
             받아 jar 의 native/sqlite-vec/ 에 넣고 같은 폴더에 VERSION 파일도 쓴다(VecExtension 이 그 파일을 읽는다 — 코드에 버전이 없다).
             버전을 올릴 때는 아래 sha256 다섯 개도 함께 바꾼다: 릴리즈 페이지의 각 파일 digest 이거나
             받은 파일에 sha256sum 을 돌린 값(캐시는 ${sqlite-vec.cache.dir}). 해시가 틀리면 빌드가 멈춘다 — 실행될 네이티브 코드라서 -->
        <sqlite-vec.version>0.1.9</sqlite-vec.version>
        <sqlite-vec.cache.dir>${user.home}/.m2/sqlite-vec/${sqlite-vec.version}</sqlite-vec.cache.dir>
        <!-- -Dsqlite-vec.skip=true: 받지도 jar 에 넣지도 않는다(네트워크 없이 빌드). 그때 앱은 SQLITE_VEC_EXTENSION_PATH 를 직접 받아야 한다 -->
        <sqlite-vec.skip>false</sqlite-vec.skip>
        <!-- 테스트 묶음(maven-surefire-plugin 설명 참고) — 기본은 @Tag("long-running") 를 뺀다. 프로파일 all-tests / long-running-tests 가 바꾼다 -->
        <test.groups></test.groups>
        <test.excludedGroups>long-running</test.excludedGroups>
        <sqlite-vec.sha256.windows-x86_64>51581189d52066b4dfc6631f6d7a3eab7dedc2260656ab09ca97ab3fb8165983</sqlite-vec.sha256.windows-x86_64>
        <sqlite-vec.sha256.macos-aarch64>8282126333399ddfe98bbbcc7a1936e7252625aac49df056a98be602e46bfd29</sqlite-vec.sha256.macos-aarch64>
        <sqlite-vec.sha256.macos-x86_64>53ad76e400786515e2edcaed2f01271dda846316390b761fadbd2dcf56aa4713</sqlite-vec.sha256.macos-x86_64>
        <sqlite-vec.sha256.linux-x86_64>b959baa1d8dc88861b1edb337b8587178cdcb12d60b4998f9d10b6a82052d5d7</sqlite-vec.sha256.linux-x86_64>
        <sqlite-vec.sha256.linux-aarch64>ea03d39541e478fab5974253c461e1cb5d77742f69e40cf96e3fad5bc309a37c</sqlite-vec.sha256.linux-aarch64>
    </properties>

