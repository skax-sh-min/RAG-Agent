    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- META-INF/build-info.properties — /settings 「정보」 카드의 버전·빌드 시각(BuildProperties) -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- sqlite-vec 로더블 확장을 jar 에 넣는다(target/classes/native/sqlite-vec/<플랫폼>/vec0.*, 그리고 VERSION).
                 받은 파일은 ${sqlite-vec.cache.dir} 에 남아 다음 빌드는 네트워크를 쓰지 않는다. 받은 tar.gz 는 pom 에 적힌 SHA-256 과
                 맞아야 한다. 출력을 <resources> 로 더하지 않고 target/classes 에 바로 쓰는 이유: 스프링 부트 부모의 <resources>(application*.properties
                 필터링)를 이 프로젝트가 다시 선언하면 그 설정을 덮어쓰게 된다.
                 앱 쪽: com.example.ragagent.config.VecExtension 이 jar 에서 현재 플랫폼의 파일을 꺼낸다. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bundle-sqlite-vec</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${sqlite-vec.skip}</skip>
                            <target>
                                <macrodef name="sqlite-vec">
                                    <attribute name="platform"/>
                                    <attribute name="sha256"/>
                                    <sequential>
                                        <local name="archive"/>
                                        <property name="archive"
                                                  value="${sqlite-vec.cache.dir}/sqlite-vec-${sqlite-vec.version}-loadable-@{platform}.tar.gz"/>
                                        <mkdir dir="${sqlite-vec.cache.dir}"/>
                                        <get src="https://github.com/asg017/sqlite-vec/releases/download/v${sqlite-vec.version}/sqlite-vec-${sqlite-vec.version}-loadable-@{platform}.tar.gz"
                                             dest="${archive}"
                                             skipexisting="true"/>
                                        <fail message="sqlite-vec @{platform}: SHA-256 mismatch for ${archive} - delete ${sqlite-vec.cache.dir} and build again. If the version was just changed, update the sqlite-vec.sha256.@{platform} property in pom.xml (expected @{sha256}).">
                                            <condition>
                                                <not>
                                                    <checksum file="${archive}" algorithm="SHA-256" property="@{sha256}"/>
                                                </not>
                                            </condition>
                                        </fail>
                                        <untar src="${archive}"
                                               dest="${project.build.outputDirectory}/native/sqlite-vec/@{platform}"
                                               compression="gzip"/>
                                    </sequential>
                                </macrodef>
                                <sqlite-vec platform="windows-x86_64" sha256="${sqlite-vec.sha256.windows-x86_64}"/>
                                <sqlite-vec platform="macos-aarch64" sha256="${sqlite-vec.sha256.macos-aarch64}"/>
                                <sqlite-vec platform="macos-x86_64" sha256="${sqlite-vec.sha256.macos-x86_64}"/>
                                <sqlite-vec platform="linux-x86_64" sha256="${sqlite-vec.sha256.linux-x86_64}"/>
                                <sqlite-vec platform="linux-aarch64" sha256="${sqlite-vec.sha256.linux-aarch64}"/>
                                <!-- 코드가 읽는 버전 파일: pom 속성이 유일한 버전 출처 -->
                                <echo file="${project.build.outputDirectory}/native/sqlite-vec/VERSION"
                                      message="${sqlite-vec.version}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 런처 jar — com.example.ragagent.launcher 패키지(JDK 만 쓴다)만 담은 작은 jar 를 앱 jar 옆에 하나 더 만든다.
                 rag-agent-<버전>-launcher.jar. 앱을 자식 프로세스로 띄우고 업데이트 교체·헬스 확인·롤백을 맡는다(OPERATOR_MANUAL 6.2.3).
                 앱 jar 는 spring-boot repackage 가 그대로 만들고 이 jar 는 건드리지 않는다. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>launcher-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>launcher</classifier>
                            <includes>
                                <include>com/example/ragagent/launcher/**</include>
                            </includes>
                            <archive>
                                <manifest>
                                    <mainClass>com.example.ragagent.launcher.Launcher</mainClass>
                                    <!-- Implementation-Version = 이 런처의 버전(런처의 version 옵션 · /admin 카드가 보인다) -->
                                    <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>
                    <!-- 앱 jar(spring-boot repackage 가 이 jar 를 다시 싸도 매니페스트 속성은 남는다) — 이 버전을 올리려면 런처가 이 프로토콜
                         이상이어야 한다는 선언. 런처·앱이 받은 jar 에서 읽는다. 기본은 1(첫 런처부터 지키는 기준선) — 앱↔런처 약속이 호환되지 않게
                         바뀌어 Launcher.PROTOCOL 을 올린 릴리즈에서만 같이 올린다(LauncherProtocolConventionTest 가 pom 과 코드를 맞춘다). -->
                    <execution>
                        <id>default-jar</id>
                        <configuration>
                            <archive>
                                <manifestEntries>
                                    <Min-Launcher-Protocol>${min.launcher.protocol}</Min-Launcher-Protocol>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 오래 걸리는 테스트(@Tag("long-running") — 릴리즈 스크립트 · 런처 시나리오: 실제 프로세스를 수십 번 띄워 전체 실행 시간을 혼자 정한다)는
                 평소 빌드에서 뺀다. 릴리즈(scripts/release.sh)는 -Pall-tests 로 전부 돌린다.
                   mvn test                          평소 — long-running 제외
                   mvn test -Pall-tests              전부(릴리즈 전)
                   mvn test -Plong-running-tests     long-running 만
                 값은 아래 프로파일이 바꾸는 속성 둘(test.groups · test.excludedGroups)이다. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups>${test.groups}</groups>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>

            <!-- JaCoCo: code coverage measurement + threshold gate -->
            <!-- 베이스라인 (Sprint 1 회귀 안전망 완료 시점): -->
            <!--   agent      = 88.2% → gate 70% -->
            <!--   repository = 73.2% → gate 70% -->
            <!--   llm        = 56.3% → gate 55% (TODO: LlmRouter 추가 테스트 후 70%) -->
            <!-- 다른 패키지 (service, controller, model, config) 는 후속 단계에서 gate 추가. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.example.ragagent.agent</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.example.ragagent.llm</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- TODO: LlmRouter executeWithTracking / executeDual / executeDualStream
                                                       추가 테스트 후 0.70 으로 상향 -->
                                            <minimum>0.55</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.example.ragagent.repository</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 전부 — 오래 걸리는 테스트(@Tag("long-running"))까지. scripts/release.sh 가 릴리즈 빌드에 붙인다 -->
        <profile>
            <id>all-tests</id>
            <properties>
                <test.excludedGroups></test.excludedGroups>
            </properties>
        </profile>
        <!-- 오래 걸리는 테스트만 -->
        <profile>
            <id>long-running-tests</id>
            <properties>
                <test.groups>long-running</test.groups>
                <test.excludedGroups></test.excludedGroups>
            </properties>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
</project>
